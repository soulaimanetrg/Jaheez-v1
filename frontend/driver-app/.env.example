# ─────────────────────────────────────────────────
# JAHEEZ Driver App — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# Backend proxy URL — absolute URL required for React Native fetch().
#
# DEVELOPMENT:
#   Leave EXPO_PUBLIC_API_BASE blank to use auto-detection from the Expo
#   dev-server hostUri (Constants.expoConfig.hostUri). This automatically
#   picks up the correct LAN IP for physical devices and emulators.
#
#   If auto-detection fails (VPN, WSL2, unusual network), set explicitly:
#   EXPO_PUBLIC_API_BASE=http://192.168.x.x:5000
#
# PRODUCTION:
#   Set to your deployed API domain:
#   EXPO_PUBLIC_API_BASE=https://api.jaheez.ma
#
# EXPO_PUBLIC_API_BASE=
