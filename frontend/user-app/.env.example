# ─────────────────────────────────────────────────
# JAHEEZ User App — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# Supabase (required — app will show error without these)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Android map display only. Restrict this key in Google Cloud to
# com.jaheez.user and the release/debug signing certificate fingerprints.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-restricted-android-maps-key

# Jaheez backend. Use a stable HTTPS origin in release builds.
EXPO_PUBLIC_ADMIN_API_BASE=https://api.example.com

# Online card payments are paused while JAHEEZ migrates to a Moroccan-compatible provider.

# Twilio/WhatsApp verification credentials belong only in Supabase or the backend.
