# ─────────────────────────────────────────────────
# JAHEEZ Root — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────

# Supabase (server-side / admin API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Supabase (frontend duplicates — used by Vite admin + Expo)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin API
# All secrets must be >= 32 chars. DRIVER_JWT_SECRET and OTP_HASH_SECRET are
# optional (fall back to ADMIN_JWT_SECRET) but recommended so one leaked
# secret does not compromise every role. Setting DRIVER_JWT_SECRET
# invalidates outstanding driver tokens (drivers re-login once).
ADMIN_JWT_SECRET=change-this-to-a-strong-random-secret-32ch
DRIVER_JWT_SECRET=change-this-to-a-different-random-secret-32ch
OTP_HASH_SECRET=change-this-to-another-random-secret-32ch
PORT=3001

# Provider OTP delivery (Wasender/Meta/Twilio) is FROZEN by default: no
# outbound OTP is sent and driver login falls back to CIN+password only.
# Set to false explicitly only when a provider is validated for production.
OTP_DELIVERY_FROZEN=true

# Customer registration OTP providers. Keep the database feature flags off
# until the matching provider has passed staging delivery and monitoring.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Jaheez <noreply@jaheez.ma>
WHATSAPP_OTP_PROVIDER=wasender
WASENDER_API_URL=https://www.wasenderapi.com/api
WASENDER_SESSION_API_KEY=your-wasender-session-api-key

# PostgreSQL migrations. Prefer SUPABASE_DB_PASSWORD; the migration runner
# builds the Supabase pooler URL from SUPABASE_URL.
SUPABASE_DB_PASSWORD=your-supabase-database-password
# Or provide a full Supabase Postgres URL instead:
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require

# Isolated staging validation (never reuse production values)
JAHEEZ_TARGET_ENV=staging
STAGING_CONFIRM_ISOLATED=true
PRODUCTION_DATABASE_URL=postgresql://production-backup-reader:password@host:5432/postgres
STAGING_DATABASE_URL=postgresql://staging-owner:password@host:5432/postgres
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
STAGING_SERVICE_ROLE_KEY=your-staging-service-role-key
STAGING_ANON_KEY=your-staging-anon-key
STAGING_API_BASE=https://staging-api.example.com/admin-api
BACKUP_ENCRYPTION_KEY=64-hex-characters
REPORT_SIGNING_KEY=at-least-32-random-characters
STAGING_TEST_ADMIN_ID=dedicated-staging-admin-uuid
STAGING_TEST_DRIVER_ID=dedicated-staging-driver-uuid
STAGING_TEST_DRIVER_CIN=dedicated-staging-driver-cin
STAGING_TEST_ORDER_ID=dedicated-staging-order-uuid
STAGING_PREPAY_REFUND_ORDER_ID=dedicated-unpaid-order-uuid
STAGING_STORE_API_KEY=prefix.secret
STAGING_OTHER_STORE_ORDER_ID=other-store-order-uuid
STAGING_CUSTOMER_ACCESS_TOKEN=dedicated-staging-customer-token
OUTBOUND_INTEGRATIONS_DISABLED=true
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled

# Infobip SMS OTP
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=your-region.api.infobip.com

# Online payments are paused while JAHEEZ migrates to a Moroccan-compatible provider.
# Future supported values for PAYMENT_PROVIDER: cmi, payzone, cashplus, manual.

# ModernMT Translation
EXPO_PUBLIC_MODERNMT_API_KEY=your-modernmt-api-key

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
