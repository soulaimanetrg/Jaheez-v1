# ═══════════════════════════════════════════════════════════════
# JAHEEZ Production Environment Variables
# Copy this to .env.production and fill in real values
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3002

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_DB_PASSWORD=your-supabase-database-password

# ── Admin JWT (MUST be unique, 64+ chars) ─────────────────────
ADMIN_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── CORS (comma-separated list of allowed origins) ────────────
CORS_ORIGINS=https://admin.jaheez.ma,https://jaheez.ma

# ── Payments ──────────────────────────────────────────────────
# Online payments stay fail-closed until a Morocco-compatible provider is configured.
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled

# ── Redis (optional but recommended for rate limiting) ────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false

# ── SMS Provider (Infobip) ────────────────────────────────────
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=https://your-base.api.infobip.com
