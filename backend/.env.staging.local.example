# JAHEEZ staging validation environment
# Copy to backend/.env.staging.local and fill the values, or copy
# backend/staging-access.private.json.example to backend/staging-access.private.json
# and run: npm run staging:import-access
# Never commit the real .env.staging.local file.

JAHEEZ_TARGET_ENV=staging
STAGING_CONFIRM_ISOLATED=true
OUTBOUND_INTEGRATIONS_DISABLED=true
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled

# PostgreSQL connection strings.
# Production is read only for encrypted backup creation.
# Staging is the isolated restore target.
PRODUCTION_DATABASE_URL=postgresql://user:password@production-host:5432/postgres
STAGING_DATABASE_URL=postgresql://user:password@staging-host:5432/postgres

# Supabase API credentials for the isolated staging project.
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
STAGING_SERVICE_ROLE_KEY=your-staging-service-role-key
STAGING_ANON_KEY=your-staging-anon-key

# BACKUP_ENCRYPTION_KEY must decode to exactly 32 bytes: use 64 hex characters or 44 base64 characters.
# REPORT_SIGNING_KEY must be at least 32 characters. Do not reuse production app secrets.
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-or-44-base64-characters
REPORT_SIGNING_KEY=replace-with-32-plus-random-characters

# Must match the ADMIN_JWT_SECRET configured on the isolated staging backend.
# Do not use the production backend secret.
ADMIN_JWT_SECRET=replace-with-staging-backend-jwt-secret

# Staging backend URL and dedicated fixture identities.
STAGING_API_BASE=https://staging-api.example.com
STAGING_TEST_ADMIN_ID=00000000-0000-0000-0000-000000000000
STAGING_TEST_DRIVER_ID=00000000-0000-0000-0000-000000000000
STAGING_TEST_DRIVER_CIN=TEST-CIN-ONLY
STAGING_TEST_ORDER_ID=00000000-0000-0000-0000-000000000000
STAGING_PREPAY_REFUND_ORDER_ID=00000000-0000-0000-0000-000000000000
STAGING_STORE_API_KEY=stg_store_key_replace_me
STAGING_OTHER_STORE_ORDER_ID=00000000-0000-0000-0000-000000000000
STAGING_CUSTOMER_ACCESS_TOKEN=replace-with-staging-customer-jwt
